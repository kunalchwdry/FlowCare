# ---------------------------------------------------------------------------
# FlowCare environment configuration  (EXAMPLE ONLY - never commit real values)
# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Every value below is a placeholder.
# The app boots with NONE of these set: it runs in DEMO_MODE with local,
# clearly-labelled synthetic data and a deterministic (non-LLM) assistant.

# === Existing FlowCare core (Phase 1) ======================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-only. Never exposed to the browser. Used by explicitly authorised
# admin/moderation/audit paths and by server-generated Care Access transitions.
# The live Care Access exchange fails closed if this is not configured.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Vercel Cron bearer secret for approval-expiration/recovery processing.
CRON_SECRET=YOUR_CRON_SECRET

# === NEW: Google Maps Platform (Phase 2 discovery) =========================
# Server-side key. Used only by /api/places/* route handlers.
# Restrict by IP (your server egress) + restrict to the APIs listed in
# docs/google-maps-setup.md. NEVER prefix this with NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=YOUR_SERVER_SIDE_GOOGLE_MAPS_API_KEY
# Browser key for the Maps JavaScript API only (map tiles rendering).
# This key IS shipped to the browser by design - it must be HTTP-referrer
# restricted and limited to "Maps JavaScript API" alone.
# If unset, FlowCare falls back to a built-in schematic (non-Google) map.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Optional Cloud-based map styling id for Advanced Markers.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Default region/language biasing for Places requests.
PLACES_DEFAULT_REGION=in
PLACES_DEFAULT_LANGUAGE=en

# === Centralized FlowCare AI ================================================
# Server-only. Never prefix these with NEXT_PUBLIC_. The browser never
# receives either value and users do not need to enter an AI provider key.
AI_DEFAULT_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah
# Gemini is retained only as an optional provider fallback during migration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Guardrails for the centralized backend endpoint.
AI_TIMEOUT_MS=8000
AI_MAX_INPUT_CHARS=400
AI_RATE_LIMIT_PER_MIN=10

# === Feature flags =========================================================
# Force the synthetic-data demo repository even when Supabase is configured.
FLOWCARE_DEMO_MODE=

# Read facility discovery and published slots from the live Supabase project
# using the publishable/anon key, so public reads still pass through RLS.
# Appointment booking uses the database booking RPC. Care Access exchange
# tables are live when the server-only service-role key above is configured.
# Review reads remain disabled until their live column vocabulary is mapped.
FLOWCARE_LIVE_READS=

# === Journey layer (F1–F20) ================================================
# F6 — Mode-aware reachability. The Google Routes API is billed separately
# from Places, so it is opt-in. When this is not 'true', FlowCare shows
# straight-line DISTANCE only and never invents a journey time.
GOOGLE_ROUTES_ENABLED=

# F16 — Cross-source discrepancy detection.
# Ships DARK. It compares FlowCare values against Google values as salted
# one-way fingerprints (never storing the Google value, per Maps Service
# Terms §14.3). Whether even a salted hash counts as "content" under those
# terms has NOT been answered by counsel — see docs/research/03-review-and-plan.md
# §10.1 R16. Both variables below must be set before the feature activates.
FLOWCARE_DISCREPANCY_ENABLED=
# A long random string. Without it, FlowCare refuses to fingerprint at all
# rather than hashing with a predictable salt.
FLOWCARE_DISCREPANCY_SALT=

# === Live database scripts (scripts/db/*) ==================================
# Used only by the migration/seed/verification scripts, never by the app.
# The direct host db.<ref>.supabase.co is IPv6-only; these scripts therefore
# go through the dual-stack Supavisor SESSION pooler (port 5432, not 6543).
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
SUPABASE_DB_REGION=ap-northeast-1
SUPABASE_DB_PORT=5432
# Optional full override if your project is not on aws-0-<region>.
SUPABASE_DB_HOST=

# Binds the demo staff/admin accounts to a hospital that exists in the
# database this deployment is reading from. Demo accounts only; a real
# Supabase session takes its hospital from app_metadata instead.
FLOWCARE_DEMO_HOSPITAL_ID=

# === Test harness ==========================================================
# The HTTP tests run against an already-running server rather than booting
# one, so point them at whichever instance you want exercised.
FLOWCARE_TEST_BASE_URL=http://127.0.0.1:3000

# Set to 1 to also run tests/live/*, which talk to the real Supabase project
# named above. Left unset they skip rather than fail, so a checkout with no
# credentials still gets a green run.
FLOWCARE_LIVE_DB=

# === MapTiler (interactive map tiles) ======================================
# Browser key: it is shipped to the client by design, exactly like the Google
# browser key, so the protection is a domain restriction on the key itself
# rather than secrecy. Restrict it to your deployed origin in the MapTiler
# dashboard. Without it the map falls back to the built-in schematic.
NEXT_PUBLIC_MAPTILER_KEY=
